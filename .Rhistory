library(sf) # manipulaciíon de datos vectoriales
library(mapview) # visualización de mapas dinámicos
library(ggplot2) # gráficos
sii_LC <- st_read("data/sii/sii_urbe_LC.shp")
# Visualización ggplot y sf
ggplot() +
geom_sf(data = sii_LC, col = "orange", alpha=0.2,  size= 0.5)+
ggtitle("Datos del SII" ) +
theme_bw() +
theme(legend.position="none")+
theme(panel.grid.major = element_line(colour = "gray80"),
panel.grid.minor = element_line(colour = "gray80"))
