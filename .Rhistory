table(violencia$dbscan_cluster)
ggplot() +
geom_sf(data = comuna_border, fill = NA, color = "gray50" )+
geom_sf(data = violencia %>% filter(dbscan_cluster!="0"),
aes(color = dbscan_cluster), alpha = 1, size = 0.3) +
scale_color_brewer(palette = "RdYlGn") +
labs(title = "Clustering DBSCAN de Delitos", color = "Clúster") +
