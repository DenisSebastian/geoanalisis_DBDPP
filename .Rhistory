landsat8 <- data.frame(
stringsAsFactors = FALSE,
NA,
check.names = FALSE,
NA,
`Sensor	Band.number	Nombre.de.la.banda	Wavelength.(μm)	Resolution.(m)	Band.Applications` = c("OLI",
"1\tCostera (Coastal)\t0.43 – 0.45\t30\tEstudios costeros y de aerosoles",
"OLI",
"2\tAzul\t0.45 – 0.51\t30\tCartografía batimétrica, que distingue el suelo de la vegetación y la vegetación caducifolia de la vegetación de coníferas",
"OLI",
"3\tVerde\t0.53 – 0.59\t30\tDestaca los picos de máxima vegetación, que son útiles para evaluar el vigor de las plantas","OLI",
"4\tRoja\t0.63 – 0.67\t30\tDistingue las laderas de vegetación",
"OLI",
"5\tInfrarrojo Cercano (NIR)\t0.85 – 0.88\t30\tDestaca el contenido de biomasa y las costas",
"OLI",
"6\tInfrarrojo de Onda Corta 1 (SWIR 1)\t1.57 – 1.65\t30\tDistingue la humedad del suelo y de la vegetación; penetra a través de nubes finas","OLI",
"7\tInfrarrojo de Onda Corta 2 (SWIR 2)\t2.11 – 2.29\t30\tMejora de la lectura de la humedad del suelo y la vegetación y la penetración a través de nubes finas",
"OLI",
"8\tPan\t0.50 – 0.68\t15\t15 meter resolution, sharper image definition",
"OLI",
"9\tCirrus\t1.36 – 1.38\t30\tImproved detection of cirrus cloud contamination","TIRS",
"10\tTIRS 1\t10.60 – 11.19\t30 (100)\t100 meter resolution, thermal mapping and estimated soil moisture",
"TIRS",
"11\tTIRS 2\t11.50 – 12.51\t30 (100)\t100 meter resolution, thermal mapping and estimated soil moisture")
)
landsat8
